    <!-- Wake word assistant -->
    <string name="wake_word_assistant">Wake word assistant</string>
    <string name="wake_word_description">Always-on voice control, in foreground and background. Say “Hey Oreshik”, “Hey Bro”, “Hi Oreshik”, “Hey Casper” or “Hi Casper” followed by a request — for example “open WhatsApp and send a text message to John”, “SSH into my server”, “open Gmail and send a message”, “create me a file”, “uninstall this app”. The assistant executes and talks back, asking for confirmation when needed.</string>
    <string name="enable_wake_word_assistant">Enable wake word assistant</string>
    <string name="wake_word_boost_volume">Boost volume during talkback</string>
    <string name="wake_word_boost_volume_description">Raises the media volume while the assistant speaks confirmations so you can hear them clearly, then restores it.</string>
    <string name="wake_word_status_listening">Wake word assistant: LISTENING • say “Hey Oreshik” or “Hey Casper” followed by your request</string>
    <string name="wake_word_status_mic_missing">Wake word assistant: enabled in app, but microphone permission is missing. Grant Android runtime permissions above.</string>
    <string name="wake_word_status_disabled">Wake word assistant: disabled — the always-on speech/mic listener is off and the microphone is not in use</string>
    <string name="wake_word_notification_title">Wake word assistant</string>
    <string name="wake_word_notification_text">Listening for “Hey Oreshik” or “Hey Casper”…</string>
    <string name="wake_word_confirm_variants">Please confirm. Do you want to proceed?|Should I go ahead?|Want me to do it?|Say go ahead if that\'s right.|Confirm and I\'ll do it.</string>
    <string name="wake_word_yes_ack_variants">Yes?|I\'m listening.|Go ahead.|Mm-hm?|What do you need?</string>
    <string name="wake_word_cancel_variants">Okay, cancelled.|Alright, dropped it.|No problem, cancelled.|Stopped.</string>
    <string name="wake_word_didnt_catch_variants">Sorry, I didn\'t catch that. Say go ahead, proceed, or cancel.|Didn\'t quite hear you — go ahead or cancel?|One more time: go ahead, or cancel?</string>
    <string name="wake_word_timeout_variants">I didn\'t hear a confirmation, so I cancelled.|No answer, so I left it alone.|Still waiting — say the wake word again when you need it.</string>
    <string name="wake_word_working_on_it">Okay, working on it.</string>
  <!-- '|'-separated talkback variants; WakeWordService picks one at random for natural speech. -->
  <string name="wake_word_working_variants">Okay, working on it.|On it.|Got it, one sec.|Sure, give me a moment.|Let me take care of that.</string>
  <string name="wake_word_done_variants">Done.|All set.|That\'s done.|Finished.</string>
    <string name="speech_clarification_description">Checks transcribed commands for likely mishearings and ambiguity before executing, and asks a short question when clarification is genuinely needed. Clear commands run without interruption. Applies to voice-control modes only — never to typed chat.</string>
    <string name="enable_speech_clarification">Enable intelligent speech clarification</string>

