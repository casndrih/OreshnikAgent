<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="5dp" android:background="@drawable/bg_nav_item" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/ivModelIcon" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_auto_awesome" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvModelId" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <!-- Live availability dot (ripple ring): green/red/orange/gray -->
            <com.example.oreshik.ModelStatusDot android:id="@+id/dotModelStatus" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="8dp" android:layout_marginEnd="6dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvModelDesc" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
