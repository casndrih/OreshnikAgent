<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:navigationIcon="@drawable/ic_arrow_back" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="@string/runtime_manager_description" android:textSize="14sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnInstallRuntime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="@string/install_runtime_pack_zip" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDownloadRuntime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:text="@string/download_optional_runtime_tools" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnProvisionPacks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:text="@string/install_bundled_packs" />
    <!-- saveEnabled=false: selectable + streamed install/provision logs must never be frozen
         into the saved-instance-state Bundle (TransactionTooLargeException crash at stop). -->
    <TextView android:id="@+id/tvProvisionStatus" android:saveEnabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="10dp" android:textIsSelectable="true" android:text="" android:textSize="12sp" />
    <ProgressBar
        android:id="@+id/runtimeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/runtimeList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="vertical" />
</LinearLayout>
