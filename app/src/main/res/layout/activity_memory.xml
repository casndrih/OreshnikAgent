<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/canvas_bg" app:navigationIcon="@drawable/ic_arrow_back" app:title="Agent Memory" app:titleTextColor="@color/text_primary"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/memory_description" android:textColor="@color/text_secondary" android:textSize="14sp"/>
        <EditText android:id="@+id/etMemory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_pill" android:hint="@string/memory_placeholder" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:padding="14dp" android:textColor="@color/text_primary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAddMemory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/save_memory"/>
        <LinearLayout android:id="@+id/memoryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp"/>
    </LinearLayout></ScrollView>
</LinearLayout>
