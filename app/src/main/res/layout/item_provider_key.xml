<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:background="@color/bg_pill"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/tvKeyMasked"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:fontFamily="monospace" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chipValidationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/not_validated"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        app:chipBackgroundColor="@color/chip_neutral"
        app:chipCornerRadius="12dp"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:id="@+id/btnRemoveKey"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/ic_close"
        android:contentDescription="@string/remove_key" />
</LinearLayout>
