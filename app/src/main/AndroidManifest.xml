<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- system.app_list inventories every installed app on Android 11+; the <queries>
         block below covers launcher/https intents, but a full inventory needs the
         broad permission. Intentional (Play-policy suppress). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- For querying all installed packages on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".OreshikApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Oreshik"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".agent.accessibility.AgentAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="Oreshik Agent Accessibility">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_service" />
            <!-- MIUI/HyperOS: request exemption from accessibility-service restrictions. -->
            <meta-data
                android:name="miui_accessibility_restriction_exempt"
                android:value="true" />
        </service>

        <!-- Notification Listener Service to monitor all notifications -->
        <service
            android:name=".notification.NotificationMonitorService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true"
            android:label="Notification Monitor">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- MIUI bypass (METHOD 4): quiet foreground service that holds a partial
             wake lock, re-applies the root battery/PowerKeeper fixes every 5 min
             and force-rebinds the accessibility service when MIUI kills it. -->
        <service
            android:name=".agent.accessibility.AccessibilityKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the accessibility-based computer-use agent alive against MIUI PowerKeeper and battery saver kills" />
        </service>

        <!-- MIUI bypass (METHOD 5/6): re-apply fixes and restart keep-alive after reboot. -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="miui.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AgentExecutionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false" />

        <!-- Always-on wake-word voice assistant -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <!-- Declares the special-use foreground service reason for Android 14+ -->
        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Autonomous coding agent execution with long-running model inference and tool orchestration" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:label="@string/voice_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".KeyManagementActivity"
            android:exported="false"
            android:label="@string/manage_api_keys" />

        <activity android:name=".RuntimeActivity" android:exported="false" />

        <activity
            android:name=".ToolsActivity"
            android:exported="false" />

        <activity
            android:name=".McpServersActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorActivity"
            android:exported="false" />

        <activity
            android:name=".ConfigActivity"
            android:exported="false" />

        <activity android:name=".MemoryActivity" android:exported="false" android:label="Memory" />
        <activity android:name=".SkillsActivity" android:exported="false" android:label="Skills" />

        <!-- Wake-word background-listening diagnostics (Android + MIUI restrictions) -->
        <activity
            android:name=".WakeWordDiagnosticsActivity"
            android:exported="false"
            android:label="Wake-word diagnostics" />

        <activity
            android:name=".ProvidersActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="Providers">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oreshik" android:host="oauth-complete" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlaceholderActivity"
            android:exported="false" />
    </application>
</manifest>
